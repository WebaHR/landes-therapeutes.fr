# Base de données
DATABASE_URL="file:./dev.db"

# Auth - générez un secret fort: openssl rand -base64 32
NEXTAUTH_SECRET="votre-secret-nextauth-ici"
NEXTAUTH_URL="http://localhost:3000"

# Google Places API (pour avis Google et géocodage)
GOOGLE_PLACES_API_KEY="votre-cle-google-places"

# INSEE / SIRENE API (validation SIREN)
SIRENE_API_KEY="votre-cle-api-sirene"

# Upload (dossier local en dev, S3/Cloudinary en prod)
UPLOAD_DIR="./public/uploads"
NEXT_PUBLIC_UPLOAD_URL="/uploads"

# Admin par défaut (créé au démarrage)
ADMIN_EMAIL="admin@landes-therapeutes.fr"
ADMIN_PASSWORD="changez-ce-mot-de-passe"
